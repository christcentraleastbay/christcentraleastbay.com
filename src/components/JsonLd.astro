---
/**
 * schema.org structured data for the church, emitted on every page so search
 * engines can tie the site to the Google Business Profile (same name, address
 * and hours) and list the upcoming Sunday services as events on the I'm New page.
 * All values come from src/data/site.ts; nothing is hardcoded here.
 */
import { site, service, contact, links } from '../data/site';

const origin = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(path, origin).href;
const churchId = absolute('/#church');
const organizationId = absolute('/#organization');

/** "YYYY-MM-DD" for the next `count` Sundays from the build (UTC is ahead of Pacific). */
function upcomingSundays(count: number) {
  const today = new Date();
  const daysToSunday = (7 - today.getUTCDay()) % 7;
  return Array.from({ length: count }, (_, i) =>
    new Date(today.getTime() + (daysToSunday + 7 * i) * 864e5).toISOString().slice(0, 10),
  );
}

// schema.org models a Church as a place (building, address, hours), so the
// congregation itself is a separate Organization node that points at it.
const church = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Church',
      '@id': churchId,
      name: site.name,
      url: absolute('/'),
      image: absolute('/images/staff-leadership.jpg'),
      description: site.description,
      address: { '@type': 'PostalAddress', ...service.postalAddress },
      geo: { '@type': 'GeoCoordinates', ...service.geo },
      hasMap: service.mapsPlaceUrl,
      containedInPlace: { '@type': 'Place', name: service.venueName },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: `https://schema.org/${service.day}`,
          opens: service.isoStartTime,
          closes: service.isoEndTime,
        },
      ],
      sameAs: [service.mapsPlaceUrl],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      alternateName: site.shortName,
      url: absolute('/'),
      logo: absolute('/images/cceb-logo-mark.png'),
      image: absolute('/images/staff-leadership.jpg'),
      description: site.description,
      email: contact.email,
      address: { '@type': 'PostalAddress', ...service.postalAddress },
      location: { '@id': churchId },
      sameAs: [contact.instagramUrl, contact.youtubeUrl, links.churchCenter, service.mapsPlaceUrl],
      parentOrganization: {
        '@type': 'Organization',
        name: 'Christ Central Presbyterian Church',
        url: links.christCentralSF,
      },
    },
    // Google needs a startDate on every Event and doesn't read eventSchedule,
    // so the I'm New page lists the next few Sundays, counted from the build.
    // Times have no UTC offset, so Google reads them in the location's time
    // zone (Pacific, daylight saving included).
    ...(Astro.url.pathname === '/im-new/' ? upcomingSundays(12) : []).map((date) => ({
      '@type': 'Event',
      '@id': absolute(`/im-new/#service-${date}`),
      name: `${service.day} Worship Service`,
      description: `Weekly worship service at ${site.name}. ${service.kidsNote}`,
      startDate: `${date}T${service.isoStartTime}`,
      endDate: `${date}T${service.isoEndTime}`,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      isAccessibleForFree: true,
      image: absolute('/images/staff-leadership.jpg'),
      location: {
        '@type': 'Church',
        '@id': churchId,
        name: site.name,
        address: { '@type': 'PostalAddress', ...service.postalAddress },
      },
      organizer: { '@type': 'Organization', '@id': organizationId, name: site.name, url: absolute('/') },
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: absolute('/im-new/') },
      url: absolute('/im-new/'),
    })),
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(church)} />
