---
interface Props {
  userId: string;
  audienceId: string;
}

const { userId, audienceId } = Astro.props;
---

<form
  action="https://christcentraleastbay.us10.list-manage.com/subscribe/post"
  method="post"
  target="_blank"
  class="mx-auto mt-6 max-w-xl"
>
  <input type="hidden" name="u" value={userId} />
  <input type="hidden" name="id" value={audienceId} />

  <div class="flex flex-col gap-3 sm:flex-row">
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="MERGE0"
      type="email"
      autocomplete="email"
      required
      placeholder="you@example.com"
      class="min-w-0 flex-1 rounded-md border border-stone-300 bg-white px-4 py-3 text-stone-900 shadow-sm outline-none transition focus:border-accent-600 focus:ring-2 focus:ring-accent-600/30 dark:border-stone-600 dark:bg-stone-800 dark:text-white"
    />
    <button type="submit" class="btn shrink-0">Sign up</button>
  </div>

  <div class="absolute -left-[5000px]" aria-hidden="true">
    <input type="text" name="b_name" tabindex="-1" autocomplete="off" />
    <input type="email" name="b_email" tabindex="-1" autocomplete="off" />
    <textarea name="b_comment" tabindex="-1"></textarea>
  </div>

  <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">
    Mailchimp will open a confirmation page in a new tab.
  </p>
</form>
